# Copy to <VPS_DEPLOY_PATH>/.env on the VPS and chmod 600.
# Replace both passwords and JWT_SECRET before deploying.
POSTGRES_DB=petfinder
POSTGRES_USER=petfinder
POSTGRES_PASSWORD=replace-with-random-password
# URL-encode special characters in the password below. Host is the Compose service db.
DATABASE_URL=postgres://petfinder:replace-with-random-password@db:5432/petfinder?sslmode=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

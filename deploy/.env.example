# Copy to <VPS_DEPLOY_PATH>/.env on the VPS and chmod 600.
# Replace both passwords and JWT_SECRET before deploying.
POSTGRES_DB=petfinder
POSTGRES_USER=petfinder
POSTGRES_PASSWORD=replace-with-random-password
# URL-encode special characters in the password below. Host is the Compose service db.
DATABASE_URL=postgres://petfinder:replace-with-random-password@db:5432/petfinder?sslmode=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# Public URL of this API (media links and the chat WebSocket URL).
PUBLIC_API_URL=https://api.example.com

# Transactional e-mail through Resend's SMTP relay (STARTTLS on port 587).
# Leave SMTP_ADDRESS empty to disable e-mail; those features then show as unavailable.
SMTP_ADDRESS=smtp.resend.com:587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_replace-with-your-resend-api-key
SMTP_FROM=Petfinder <no-reply@example.com>
# The web app's reset page; the API appends ?token=...
PASSWORD_RESET_URL=https://app.example.com/reset-password

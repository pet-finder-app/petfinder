# API
HTTP_ADDR=:8080
API_PORT=8080
APP_ENV=development
SHUTDOWN_TIMEOUT=10s

# Change the secret in any shared or production environment.
JWT_SECRET=local-development-secret-change-me
JWT_ISSUER=petfinder-api
JWT_AUDIENCE=petfinder
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# PostgreSQL local/Compose
POSTGRES_DB=petfinder
POSTGRES_USER=petfinder
POSTGRES_PASSWORD=petfinder
POSTGRES_PORT=5432
DATABASE_URL=postgres://petfinder:petfinder@localhost:5432/petfinder?sslmode=disable

# Transactional email (authenticated STARTTLS relay). Empty SMTP_ADDRESS disables delivery.
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PUBLIC_API_URL=http://localhost:8080

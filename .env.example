# API
HTTP_ADDR=:8080
API_PORT=8080
APP_ENV=development
SHUTDOWN_TIMEOUT=10s

# Troque o segredo em qualquer ambiente compartilhado ou de produção.
JWT_SECRET=local-development-secret-change-me
JWT_ISSUER=petfinder-api
JWT_AUDIENCE=petfinder
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# PostgreSQL local/Compose
POSTGRES_DB=petfinder
POSTGRES_USER=petfinder
POSTGRES_PASSWORD=petfinder
POSTGRES_PORT=5432
DATABASE_URL=postgres://petfinder:petfinder@localhost:5432/petfinder?sslmode=disable
